EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Powers PlaceField's address autocomplete (destination/stops/home base) in
# the app itself. This one IS bundled into the client, unlike the secrets
# below — restrict it in Google Cloud Console to this app's iOS bundle ID /
# Android package name (and to just the Places API) so it can't be reused
# elsewhere if someone extracts it from the app binary.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your-google-places-api-key

# --- worker/ only (never read by the Expo app itself — these are NOT
# EXPO_PUBLIC_*, so Metro never bundles them into the app) -------------
#
# The SECRET key from Supabase's dashboard (Project Settings -> API ->
# "secret key", sb_secret_...) — NOT the publishable/anon key above. It
# bypasses row-level security, which is what lets the worker claim jobs and
# write results for clips it doesn't own. Never put this key in the app.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# Get one at https://console.apify.com/settings/integrations
APIFY_API_TOKEN=your-apify-token

# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Biases geocoding toward a trip's own destination (see worker/src/geocode.ts).
# Same underlying Google Cloud project as EXPO_PUBLIC_GOOGLE_PLACES_API_KEY
# above, but this copy is server-only and doesn't need the bundle-ID
# restriction the client one does.
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# --- worker/ tuning (all optional — sensible defaults if omitted) -------
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# MAX_FRAMES_VISION=8
# WORKER_POLL_INTERVAL_MS=5000
# WORKER_STALE_JOB_TIMEOUT_MS=600000
